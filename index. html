<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI Talking Camera</title>
<style>
 body{margin:0;background:#000;color:#fff;font-family:sans-serif;text-align:center}
 video{width:100%;max-height:70vh;background:#111;border-radius:16px}
 button{padding:15px 30px;margin:10px;border:0;border-radius:30px;font-size:18px;font-weight:bold}
 #talk{background:#22c55e;color:#000} #stop{background:#ef4444;color:#fff}
 #label{padding:12px;font-size:18px}
</style>
</head>
<body>
<h2>🎥 AI Talking Camera</h2>
<video id="video" autoplay playsinline muted></video>
<canvas id="canvas" style="display:none"></canvas>
<div id="label">Starting camera...</div>
<button id="talk">▶️ START TALKING</button>
<button id="stop">⏹️ STOP</button>

<script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.22.0/dist/tf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/coco-ssd@2.2.3/dist/coco-ssd.min.js"></script>
<script>
let video=document.getElementById('video');
let label=document.getElementById('label');
let model, talking=false, interval;

async function setup(){
  const stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'environment'}});
  video.srcObject=stream;
  label.innerText='Loading AI model...';
  model=await cocoSsd.load();
  label.innerText='Ready! Tap START TALKING';
}
setup();

function speak(text){
  speechSynthesis.cancel();
  let u=new SpeechSynthesisUtterance(text);
  u.rate=0.95; u.pitch=1.1;
  speechSynthesis.speak(u);
}

async function detectAndTalk(){
  if(!model || !talking) return;
  const preds=await model.detect(video);
  if(preds.length>0){
    let objects=preds.map(p=>p.class).slice(0,3).join(', ');
    let text=`I can see ${objects}.`;
    if(preds[0].class=='person') text=`Hey! I see a person! ${Math.round(preds[0].score*100)} percent sure. Hello there!`;
    label.innerText=text;
    speak(text);
  }else{
    label.innerText='I see nothing... show me something!';
  }
}

document.getElementById('talk').onclick=()=>{
  talking=true;
  speak('Hello Stanley! I am your talking camera, I can see you now.');
  interval=setInterval(detectAndTalk, 4000);
  label.innerText='I am watching and talking every 4 seconds...';
}
document.getElementById('stop').onclick=()=>{
  talking=false; clearInterval(interval);
  speechSynthesis.cancel();
  label.innerText='Stopped.';
}
</script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My AI Talking Camera</title>
  <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.22.0"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/coco-ssd@2.2.3"></script>
</head>
<body>
  <h2>My AI Talking Camera</h2>
  <p id="status">Loading AI model...</p>
  <video id="camera" autoplay playsinline
    muted style="width:100%;"></video>
  <button onclick="startCamera()">Start Camera</button>
  <button onclick="stopCamera()">Stop Camera</button>
  <h3 id="result">Objects will appear here</h3>

  <script>
    let model, stream, running = false, lastSpoken = "";

    async function loadModel() {
      try {
        model = await cocoSsd.load();
        document.getElementById("status").textContent =
          "AI ready. Open this page through HTTPS to use the camera.";
      } catch (e) {
        document.getElementById("status").textContent =
          "Model failed to load. Check your internet.";
      }
    }

    async function startCamera() {
      try {
        if (!model) await loadModel();
        stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: "environment" }, audio: false
        });
        const video = document.getElementById("camera");
        video.srcObject = stream;
        await video.play();
        running = true;
        detect();
      } catch (e) {
        alert("Camera failed. Open this page using an HTTPS website and allow camera permission.");
      }
    }

    async function detect() {
      if (!running || !model) return;
      const video = document.getElementById("camera");
      if (video.readyState >= 2) {
        const predictions = await model.detect(video);
        if (predictions.length) {
          const name = predictions[0].class;
          document.getElementById("result").textContent =
            "I see: " + predictions.map(p => p.class).join(", ");
          if (name !== lastSpoken) {
            speechSynthesis.cancel();
            speechSynthesis.speak(new SpeechSynthesisUtterance(name));
            lastSpoken = name;
          }
        }
      }
      if (running) setTimeout(detect, 800);
    }

    function stopCamera() {
      running = false;
      if (stream) stream.getTracks().forEach(t => t.stop());
      speechSynthesis.cancel();
      document.getElementById("camera").srcObject = null;
      document.getElementById("status").textContent = "Camera stopped.";
    }

    loadModel();
  </script>
</body>
</html>
